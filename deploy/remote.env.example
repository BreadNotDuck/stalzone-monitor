# Скопируй в deploy/remote.env и заполни (файл в .gitignore).
# После этого агент или ты можешь деплоить: python deploy/push.py

VPS_HOST=123.45.67.89
VPS_USER=root
VPS_PORT=22
VPS_APP_DIR=/opt/stalzone-monitor

