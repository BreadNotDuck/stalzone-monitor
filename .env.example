# Токен приложения STALZONE (получить через https://eapi.stalzone.com/registration.html)
STALZONE_API_TOKEN=

# Альтернатива токену — client id/secret из Telegram-бота регистрации API
STALZONE_CLIENT_ID=
STALZONE_CLIENT_SECRET=

# Telegram Bot API (создать бота через @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Опционально: прокси для Telegram API (если api.telegram.org недоступен)
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# Часовой пояс контейнера/сервера
TZ=Europe/Moscow
