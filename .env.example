# Токен приложения STALZONE (получить через https://eapi.stalzone.com/registration.html)
STALZONE_API_TOKEN=

# Альтернатива токену — client id/secret из Telegram-бота регистрации API
STALZONE_CLIENT_ID=
STALZONE_CLIENT_SECRET=

# Telegram Bot API (создать бота через @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# VPN-подписка (Clash/VLESS) — нужна, если с VPS блокируется api.telegram.org
# PROXY_SUB_URL=https://example.com/your-subscription

# Прокси внутри docker-compose (сервис proxy / mihomo). Обычно не трогай.
HTTPS_PROXY=http://proxy:7890
HTTP_PROXY=http://proxy:7890
NO_PROXY=localhost,127.0.0.1,proxy

# Часовой пояс контейнера/сервера
TZ=Europe/Moscow
